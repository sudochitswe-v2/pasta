# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Explicit text files
*.go text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.service text eol=lf
Makefile text eol=lf

# Shell scripts must always use LF
*.sh text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.exe binary
